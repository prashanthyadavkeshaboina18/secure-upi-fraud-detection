APP_NAME=Secure UPI API
ENV=development

# Local dev / tests: sqlite:///./secure_upi.db
# Production:        mysql+pymysql://user:password@host:3306/secure_upi
DATABASE_URL=sqlite:///./secure_upi.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated, no trailing slash on any origin
CORS_ORIGINS=http://localhost:5173

# 0-100 risk score bands. score <= RISK_LOW_MAX -> LOW,
# up to RISK_MEDIUM_MAX -> MEDIUM, above -> HIGH.
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

ML_ARTIFACTS_DIR=app/ml_runtime/artifacts
